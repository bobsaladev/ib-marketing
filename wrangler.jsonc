{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ibmkt",
  "compatibility_date": "2026-07-25",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Producción Bobsala: ibmkt.bobsala.com
  // Para una copia de Isaac: cambia `name` y `routes[].pattern` (o quita `routes`
  // y usa solo *.workers.dev). Ver AGENTS.md.
  "routes": [
    {
      "pattern": "ibmkt.bobsala.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
